# Production Backend API URL (must include https:// in production)
# Example: https://campus-hq-api.onrender.com/
VITE_BACKEND_SERVER="https://your-backend-api.onrender.com/"

# Base URL for static/uploaded files (photos, PDFs, receipts)
VITE_FILE_BASE_URL="https://your-backend-api.onrender.com/"

# Remote dev toggle (leave empty or set to 'remote' to proxy to remote backend during local development)
# VITE_DEV_REMOTE="remote"
