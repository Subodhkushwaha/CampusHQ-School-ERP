# ==========================================
# CAMPUSHQ SCHOOL ERP - FRONTEND ENVIRONMENT CONFIGURATION (VERCEL)
# ==========================================

# Production Backend API URL (configure in Vercel Dashboard -> Environment Variables)
# Example: https://campushq-backend-production.up.railway.app
VITE_BACKEND_SERVER="https://<your-backend-service>.up.railway.app"

# Base URL for static/uploaded files (photos, PDFs, receipts)
VITE_FILE_BASE_URL="https://<your-backend-service>.up.railway.app"

# Remote dev toggle (leave empty or set to 'remote' to proxy to remote backend during local development)
# VITE_DEV_REMOTE="remote"

