# ==========================================
# CAMPUSHQ SCHOOL ERP - BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Database Connection
# Production: MongoDB Atlas connection string
# Local Dev: mongodb://127.0.0.1:27017/idurar (falls back automatically to embedded MongoDB if local is offline)
DATABASE="mongodb+srv://<username>:<password>@cluster0.fzeutel.mongodb.net/campushq?retryWrites=true&w=majority"

# Server Port (Render/Railway/Heroku inject this automatically)
PORT=8888

# Application Environment (development | production)
NODE_ENV="production"

# Authentication & Security
# Strong secret used to sign and verify JWT authentication tokens
JWT_SECRET="your_secure_random_64_char_jwt_secret_key_here"

# CORS & Allowed Origins
# Production: Your deployed Vercel frontend URL (e.g., https://campus-hq-school-erp.vercel.app)
# Multiple origins can be comma-separated
FRONTEND_URL="https://campus-hq-school-erp.vercel.app"
WEBSITE_URL="https://campus-hq-school-erp.vercel.app"

# Public File Serving URL
# URL where backend public assets (e.g. photos, logos) are served from
PUBLIC_SERVER_FILE="https://campushq-school-erp.onrender.com/"

# ------------------------------------------
# OPTIONAL INTEGRATIONS
# ------------------------------------------

# Email Notification Service (Resend)
# RESEND_API="re_your_resend_api_key"

# AI Assistant Features (OpenAI)
# OPENAI_API_KEY="sk-your_openai_api_key"

# Cloud Object Storage (DigitalOcean Spaces / AWS S3)
# DO_SPACES_KEY="your_spaces_or_s3_access_key"
# DO_SPACES_SECRET="your_spaces_or_s3_secret_key"
# DO_SPACES_URL="nyc3.digitaloceanspaces.com"
# DO_SPACES_NAME="campushq-uploads"
# REGION="us-east-1"
