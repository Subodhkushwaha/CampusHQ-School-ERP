# ==========================================
# CAMPUSHQ SCHOOL ERP - BACKEND ENVIRONMENT CONFIGURATION (RAILWAY / LOCAL)
# ==========================================

# Database Connection (Primary: DATABASE, Fallback: MONGODB_URI)
# Production: MongoDB Atlas connection string targeting the "campushq" database
# Local Dev: mongodb://127.0.0.1:27017/campushq
DATABASE="mongodb+srv://<db_username>:<db_password>@cluster0.fzeutel.mongodb.net/campushq?retryWrites=true&w=majority"

# Server Port (Railway automatically injects $PORT in production; default 8888 locally)
PORT=8888

# Application Environment (development | production)
NODE_ENV="production"

# Authentication & Security
# Cryptographically secure random 64-character secret for signing session JWT tokens
JWT_SECRET="generate_a_secure_random_64_character_hex_or_alphanumeric_secret"

# CORS & Allowed Origins
# Production: Your deployed Vercel frontend URL (e.g., https://campus-hq-school-erp.vercel.app)
# Multiple origins can be comma-separated
FRONTEND_URL="https://campus-hq-school-erp.vercel.app"
WEBSITE_URL="https://campus-hq-school-erp.vercel.app"

# Public File Serving Base URL (Used for PDF invoice branding logos and uploaded assets)
# Set to your Railway public domain (e.g. https://campushq-backend-production.up.railway.app/)
PUBLIC_SERVER_FILE="https://<your-backend-service>.up.railway.app/"

# Initial Bootstrap Credentials (Optional - only needed if running "npm run setup" on empty DB)
# INITIAL_ADMIN_EMAIL="admin@admin.com"
# INITIAL_ADMIN_PASSWORD="a_strong_temporary_bootstrap_password"

# ------------------------------------------
# OPTIONAL INTEGRATIONS
# ------------------------------------------

# Email Notification Service (Resend)
# RESEND_API="re_your_resend_api_key"

# AI Assistant Features (OpenAI)
# OPENAI_API_KEY="sk-your_openai_api_key"

# Cloud Object Storage (DigitalOcean Spaces / AWS S3)
# DO_SPACES_KEY="your_spaces_or_s3_access_key"
# DO_SPACES_SECRET="your_spaces_or_s3_secret_key"
# DO_SPACES_URL="nyc3.digitaloceanspaces.com"
# DO_SPACES_NAME="campushq-uploads"
# REGION="us-east-1"

