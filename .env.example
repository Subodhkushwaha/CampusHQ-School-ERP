# ==============================================================================
# CAMPUSHQ SCHOOL ERP — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy backend variables to backend/.env and frontend variables to frontend/.env
# In production, set these directly in your hosting platform dashboard (Vercel / Render / Railway).

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (backend/.env or Render/Railway Settings)
# ------------------------------------------------------------------------------
# MongoDB Connection String (MongoDB Atlas)
DATABASE="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campushq?retryWrites=true&w=majority"

# Node Environment
NODE_ENV="production"

# Port (managed automatically by hosting platform or defaults to 8888)
PORT=8888

# JWT Signing Secret (generate a strong random string)
JWT_SECRET="your_secure_random_64_char_jwt_secret_key_here"

# Allowed CORS Origin(s) (your Vercel frontend URL)
FRONTEND_URL="https://your-frontend.vercel.app"
WEBSITE_URL="https://your-frontend.vercel.app"

# Base URL for public file downloads and assets
PUBLIC_SERVER_FILE="https://your-backend-api.onrender.com/"

# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env or Vercel Project Settings)
# ------------------------------------------------------------------------------
# Deployed Backend HTTPS URL
VITE_BACKEND_SERVER="https://your-backend-api.onrender.com/"
VITE_FILE_BASE_URL="https://your-backend-api.onrender.com/"
