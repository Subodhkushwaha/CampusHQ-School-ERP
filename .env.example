# ==============================================================================
# CAMPUSHQ SCHOOL ERP — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# In production:
# - Set backend variables in Railway Dashboard -> Service -> Variables
# - Set frontend variables in Vercel Dashboard -> Settings -> Environment Variables
# For local dev, copy to backend/.env and frontend/.env respectively.

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Railway Service Settings or backend/.env)
# ------------------------------------------------------------------------------
# MongoDB Connection String (MongoDB Atlas - primary: DATABASE, fallback: MONGODB_URI)
DATABASE="mongodb+srv://<username>:<password>@cluster0.fzeutel.mongodb.net/campushq?retryWrites=true&w=majority"

# Node Environment
NODE_ENV="production"

# Port (managed automatically by Railway via injected $PORT; defaults to 8888 locally)
PORT=8888

# JWT Signing Secret (generate a strong random 64-char string)
JWT_SECRET="generate_a_secure_random_64_character_hex_or_alphanumeric_secret"

# Allowed CORS Origin(s) (your Vercel frontend URL)
FRONTEND_URL="https://campus-hq-school-erp.vercel.app"
WEBSITE_URL="https://campus-hq-school-erp.vercel.app"

# Base URL for public file downloads and assets (Railway public domain)
PUBLIC_SERVER_FILE="https://<your-backend-service>.up.railway.app/"

# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Vercel Project Settings or frontend/.env)
# ------------------------------------------------------------------------------
# Deployed Railway Backend HTTPS URL
VITE_BACKEND_SERVER="https://<your-backend-service>.up.railway.app"
VITE_FILE_BASE_URL="https://<your-backend-service>.up.railway.app"

